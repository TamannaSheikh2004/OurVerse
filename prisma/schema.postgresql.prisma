generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(uuid())
  username              String   @unique
  passwordHash          String
  recoveryKeyHash       String
  displayName           String?
  avatarUrl             String?
  allowUniverseRequests String   @default("EVERYONE") // EVERYONE, NOBODY
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  memberships         UniverseMember[]
  sentInvitations     UniverseInvitation[] @relation("SentInvitations")
  receivedInvitations UniverseInvitation[] @relation("ReceivedInvitations")
  blockedUsers        BlockedUser[]        @relation("BlockedUsers")
  blockedByUsers      BlockedUser[]        @relation("BlockedByUsers")
  messages            Message[]            @relation("SentMessages")
  reactions           MessageReaction[]    @relation("UserReactions")
  readReceipts        ReadReceipt[]        @relation("UserReadReceipts")

  @@index([username])
}

model ReservedUsername {
  username       String   @id
  reservedAt     DateTime @default(now())
  originalUserId String?
  reason         String   @default("REGISTERED")

  @@index([username])
}

model Universe {
  id         String   @id @default(uuid())
  universeId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members             UniverseMember[]
  messages            Message[]
  guardian            Guardian?
  guardianEvents      GuardianEvent[]
  dailySummaries      GuardianDailySummary[]
  weeklySummaries     GuardianWeeklySummary[]
  monthlySummaries    GuardianMonthlySummary[]
  timelines           GuardianTimeline[]
  relationshipProfile GuardianRelationshipProfile?

  @@index([universeId])
}

model UniverseMember {
  id         String   @id @default(uuid())
  universeId String
  userId     String
  joinedAt   DateTime @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([universeId, userId])
  @@index([userId])
  @@index([universeId])
}

model UniverseInvitation {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  status      String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, BLOCKED, EXPIRED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  sender   User @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Message {
  id               String            @id @default(uuid())
  messageId        String            @unique
  universeId       String
  senderId         String
  type             String            @default("TEXT") // TEXT, IMAGE, VIDEO, FILE, VOICE, LOCATION, SYSTEM
  content          String
  metadata         String            @default("{}") // Flexible JSON string
  replyToMessageId String?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  status           String            @default("SENT") // SENT, DELIVERED, READ, DELETED

  universe     Universe          @relation(fields: [universeId], references: [id], onDelete: Cascade)
  sender       User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  readReceipts ReadReceipt[]

  @@index([universeId, createdAt])
  @@index([senderId])
  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserReadReceipts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model Guardian {
  id         String   @id @default(uuid())
  guardianId String   @unique // Custom readable ID: GRD-XXXXXXXX
  universeId String   @unique
  status     String   @default("ACTIVE") // ACTIVE, HIBERNATED, ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([guardianId])
}

model GuardianEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique // Custom readable ID: EVT-XXXXXXXX
  eventType   String    // UniverseCreated, MessageCreated, etc.
  universeId  String
  messageId   String?
  payload     String    @default("{}") // JSON string
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRYING
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  retryCount  Int       @default(0)

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model GuardianDailySummary {
  id           String   @id @default(uuid())
  universeId   String
  summaryDate  DateTime
  messageCount Int      @default(0)
  content      String   // Daily summary placeholder text
  metadata     String   @default("{}") // JSON string
  createdAt    DateTime @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, summaryDate])
  @@index([universeId])
  @@index([summaryDate])
}

model GuardianWeeklySummary {
  id            String   @id @default(uuid())
  universeId    String
  weekStartDate DateTime
  content       String   // Weekly summary placeholder text
  metadata      String   @default("{}") // JSON string
  createdAt     DateTime @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, weekStartDate])
  @@index([universeId])
  @@index([weekStartDate])
}

model GuardianMonthlySummary {
  id             String   @id @default(uuid())
  universeId     String
  monthStartDate DateTime
  content        String   // Monthly summary placeholder text
  metadata       String   @default("{}") // JSON string
  createdAt      DateTime @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, monthStartDate])
  @@index([universeId])
  @@index([monthStartDate])
}

model GuardianTimeline {
  id          String   @id @default(uuid())
  universeId  String
  type        String   // UNIVERSE_CREATED, MILESTONE_DETECTED, HABIT_DETECTED, DAILY_SUMMARY, etc.
  referenceId String?
  description String
  metadata    String   @default("{}") // JSON string
  createdAt   DateTime @default(now())

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId, createdAt])
  @@index([type])
}

model GuardianRelationshipProfile {
  id                 String   @id @default(uuid())
  universeId         String   @unique
  learningStage      String   @default("BASELINE_OBSERVATION")
  messagesProcessed  Int      @default(0)
  summariesGenerated Int      @default(0)
  timelineEntries    Int      @default(0)
  processingStatus   String   @default("IDLE") // IDLE, PROCESSING, COMPLETED, FAILED
  workerHealth       String   @default("HEALTHY") // HEALTHY, DEGRADED, FAILED
  metadata           String   @default("{}") // JSON string
  updatedAt          DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@index([universeId])
}

model GuardianWorkerLog {
  id           String   @id @default(uuid())
  workerName   String
  universeId   String?
  status       String   // STARTED, COMPLETED, FAILED
  durationMs   Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([workerName])
  @@index([universeId])
  @@index([createdAt])
}

model GuardianProcessingQueue {
  id          String    @id @default(uuid())
  jobId       String    @unique
  jobType     String
  universeId  String
  payload     String    @default("{}") // JSON string
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRYING
  priority    Int       @default(0)
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  scheduledAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, priority, scheduledAt])
  @@index([universeId])
  @@index([jobType])
}
