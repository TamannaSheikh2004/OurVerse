# ====================================================
# BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# ====================================================

# Runtime mode: development | production
NODE_ENV=production

# Server listening port (Render sets PORT automatically)
PORT=4000

# Prisma Database Connection URL
# Local Dev (SQLite): "file:./dev.db"
# Render Prod (PostgreSQL): "postgresql://username:password@ep-xyz.render.com/ourverse?sslmode=require"
DATABASE_URL="postgresql://username:password@localhost:5432/ourverse?schema=public"

# JWT Token Signing Secret (Must be strong 32+ char secret in production)
JWT_SECRET="your-production-jwt-secret-key"

# Production Frontend Origin for CORS Validation (Netlify URL)
FRONTEND_URL="https://ourverse.netlify.app"


# ====================================================
# FRONTEND ENVIRONMENT VARIABLES (Netlify Static Site)
# ====================================================

# Backend API & WebSocket Endpoint URL (Render Backend URL)
# Local Dev: Leave empty or "http://localhost:4000"
# Netlify Prod: "https://ourverse-backend.onrender.com"
VITE_API_URL="https://ourverse-backend.onrender.com"
